{
  "name": "street-life-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node tests/run.cjs",
    "test:design": "node check-design-system.cjs",
    "test:visual": "playwright test --project=visual-mobile --project=visual-desktop",
    "test:visual:update": "playwright test --project=visual-mobile --project=visual-desktop --update-snapshots=all",
    "test:smoke": "playwright test --project=smoke-chromium",
    "test:smoke:webkit": "playwright test --project=smoke-webkit",
    "test:browser": "playwright test --project=visual-mobile --project=visual-desktop --project=smoke-chromium"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@sparticuz/chromium": "143.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tar-fs": "3.1.3"
  }
}
